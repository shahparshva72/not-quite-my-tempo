{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "not-quite-my-tempo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  // Production origin. Cloudflare creates the DNS record and certificate on
  // deploy; the zone must be in the same account.
  "routes": [{ "pattern": "notmytempo.dev", "custom_domain": true }],
  // Serve only on the custom domain: links and redirects are built from the
  // request origin, so a second public hostname must not exist.
  "workers_dev": false,
  // Icons and the link preview image (tools/brand-assets renders them).
  // Served before the Worker runs, so they skip its security headers.
  "assets": { "directory": "./public" },
  "observability": { "enabled": true },
  // Every 15 minutes: fail reviews whose workflow died (stuck-runs.ts).
  "triggers": { "crons": ["*/15 * * * *"] },
  "workflows": [
    {
      "binding": "REVIEW_PULL_REQUEST_WORKFLOW",
      "name": "review-pull-request",
      "class_name": "ReviewPullRequestWorkflow",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "not-quite-my-tempo",
      "database_id": "3143afbb-2d35-472d-a3b2-49e0c09c4120",
      "migrations_dir": "../../packages/db/drizzle",
    },
  ],
}
