{
  "name": "@not-quite-my-tempo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm types && wrangler deploy --dry-run",
    "db:create": "wrangler d1 create not-quite-my-tempo --binding DB",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "pnpm types && wrangler deploy",
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm types && tsc --noEmit -p tsconfig.json",
    "typecheck:test": "pnpm types && tsc --noEmit -p test/tsconfig.json",
    "types": "wrangler types"
  },
  "dependencies": {
    "@not-quite-my-tempo/core": "workspace:*",
    "@not-quite-my-tempo/db": "workspace:*",
    "@not-quite-my-tempo/gemini": "workspace:*",
    "effect": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "wrangler": "catalog:"
  }
}
