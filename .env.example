# Required Worker secret used to verify the HMAC-SHA256 signature on GitHub
# webhook requests. Wrangler loads it from apps/api/.dev.vars locally and from
# the deployed Worker's secret store in Cloudflare. Never commit the real value.
GITHUB_WEBHOOK_SECRET=

# Required GitHub App ID (numeric) used to sign the RS256 App JWT for
# installation token exchange. Wrangler loads it from apps/api/.dev.vars
# locally and from the deployed Worker's secret store in Cloudflare.
GITHUB_APP_ID=

# Required GitHub App private key in PKCS#8 PEM format. GitHub downloads keys
# as PKCS#1 ("BEGIN RSA PRIVATE KEY"); convert before use:
#   openssl pkcs8 -topk8 -inform PEM -outform PEM -nocrypt \
#     -in app.pem -out app.pkcs8.pem
# Never commit the real value.
GITHUB_APP_PRIVATE_KEY=

# Required GitHub App slug: the URL name from https://github.com/apps/<slug>.
# Not a secret. The onboarding page links to
# https://github.com/apps/<slug>/installations/new. Wrangler loads it from
# apps/api/.dev.vars locally; in production set it as a plain var in
# apps/api/wrangler.jsonc or with `wrangler secret put`.
GITHUB_APP_SLUG=

# Required OAuth credentials from the same GitHub App (Settings → General →
# "Client ID" and a generated client secret). Used for the dashboard's
# "Sign in with GitHub" flow. Wrangler loads them from apps/api/.dev.vars
# locally and from the Worker secret store in production.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Required secret used to HMAC-hash opaque session tokens for D1 storage.
# Generate a long random value (e.g. `openssl rand -hex 32`). Rotating it signs
# everyone out. Loaded from apps/api/.dev.vars locally and Worker secrets in
# production. Cookies contain only random tokens, never account permissions.
SESSION_SECRET=

# Required key for encrypting stored GitHub user tokens (AES-256-GCM), used
# to refresh each session's repository access every 10 minutes. 32 random
# bytes, base64: `openssl rand -base64 32`. Rotating it makes stored tokens
# unreadable; affected sessions keep their last access until they expire.
# Loaded from apps/api/.dev.vars locally and Worker secrets in production.
TOKEN_ENCRYPTION_KEY=

# Required Gemini API key used by the review Workflow to call
# generateContent. Wrangler loads it from apps/api/.dev.vars locally and from
# the deployed Worker's secret store in Cloudflare. Never commit the real
# value.
GEMINI_API_KEY=

# Optional. Set to "vertex_express" when GEMINI_API_KEY is a Vertex AI API
# key (express mode, aiplatform.googleapis.com); leave empty for a Gemini
# Developer API key from Google AI Studio. Not a secret; set it under "vars"
# in apps/api/wrangler.jsonc in production. Workspace keys don't need this:
# Fletcher detects their API when they're saved.
GEMINI_API_PROVIDER=

# Optional Gemini model ID. Defaults to gemini-3.8-flash when unset. Not a
# secret; set it as a plain var in apps/api/wrangler.jsonc if overriding in
# production.
GEMINI_MODEL=

# Optional Polar (polar.sh) billing for the paid plan. Billing turns on only
# when POLAR_ACCESS_TOKEN, POLAR_PRODUCT_ID, and POLAR_WEBHOOK_SECRET are all
# set; otherwise there's no Subscribe button, only BYOK and the 5-review
# trial. See docs/BILLING.md.
#
# POLAR_ACCESS_TOKEN: secret organization access token with checkouts:write,
# customer_sessions:write, subscriptions:read, and products:read. Loaded from
# apps/api/.dev.vars locally and `wrangler secret put POLAR_ACCESS_TOKEN` in
# production.
POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET: secret "whsec_..." value of the Polar webhook that
# points at <origin>/webhooks/polar. Loaded like POLAR_ACCESS_TOKEN.
POLAR_WEBHOOK_SECRET=
# POLAR_PRODUCT_ID: the recurring Polar product for the paid plan. Not a
# secret; set it under "vars" in apps/api/wrangler.jsonc in production.
POLAR_PRODUCT_ID=
# POLAR_SERVER: "sandbox" to use sandbox.polar.sh; empty means production.
# Not a secret; set it under "vars" in apps/api/wrangler.jsonc.
POLAR_SERVER=

# D1 is provided through the DB binding in apps/api/wrangler.jsonc.
# Configure the database_id there before using remote database commands.
# Drizzle uses that binding; no DATABASE_URL is needed.
#
# Keep this file updated when environment variables are added, changed, or removed.
# Document each variable's purpose and whether it is required or optional.
# Use empty values or safe placeholders; never include real credentials.
